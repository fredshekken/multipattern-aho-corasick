{
  "name": "Endpoint Phishing Shield Test",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "content_scripts": [
    {
      "matches": ["*://*/*test_chat.html*", "file:///*test_chat.html*","https://web.telegram.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}